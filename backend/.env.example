# 生产环境配置示例（根据实际情况修改）

# 应用配置
APP_NAME=AI项目推进控制塔
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# 安全配置（必须修改！）
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INITIAL_ADMIN_USERNAME=admin
# 生产环境必须设置强密码，不能使用 admin123
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# 当前正式部署使用 SQLite；运行数据通过 Docker volume 持久化
DB_TYPE=sqlite

# 仅切换 PostgreSQL 时使用
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_control_tower
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=your_password_here

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://yourdomain.com"]

# DeepSeek 配置（可选，MVP阶段可不配置）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_TIMEOUT=30
DEEPSEEK_VERIFY_SSL=True
DAILY_REPORT_AI_ENABLED=True
DAILY_REPORT_AI_AUTO_MATCH_SCORE=0.92
EMAIL_AI_ENABLED=true
EMAIL_AI_AUTO_MATCH_SCORE=0.92

# 钉钉集成配置（可选，MVP阶段可不配置）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/var/log/ai-control-tower/app.log

# 文件上传配置
UPLOAD_DIR=/opt/ai-control-tower/uploads
MAX_UPLOAD_SIZE=10485760

# 预警通知配置
ENABLE_WARNING_NOTIFICATION=True
WARNING_CHECK_HOUR=9

# 项目活动日报同步
DAILY_REPORT_SYNC_ENABLED=True
DAILY_REPORT_SYNC_HOUR=9
DAILY_REPORT_SYNC_MINUTE=45
DAILY_REPORT_SYNC_LOOKBACK_DAYS=3
DAILY_REPORT_SYNC_AUTO_MATCH_SCORE=0.86
DAILY_REPORT_API_BASE_URL=https://192.168.1.180
DAILY_REPORT_API_KEY=your-northbound-api-key
DAILY_REPORT_API_KEY_HEADER=X-NB-API-Key
DAILY_REPORT_API_VERIFY_SSL=False
DAILY_REPORT_API_ALLOW_HTTP_FALLBACK=True
DAILY_REPORT_API_TIMEOUT=30
# Gmail 邮件情报接入（不要填写邮箱密码）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8001/api/v1/email-intelligence/oauth/callback
GMAIL_ACCOUNT_EMAIL=
GMAIL_SYNC_ENABLED=false

# 钉钉企业邮箱（密码建议使用邮箱客户端专用密码/授权码）
DINGTALK_MAIL_ENABLED=false
DINGTALK_MAIL_ACCOUNT_EMAIL=
DINGTALK_MAIL_PASSWORD=
DINGTALK_MAIL_IMAP_HOST=imap.qiye.aliyun.com
DINGTALK_MAIL_IMAP_PORT=993
DINGTALK_MAIL_IMAP_SSL=true
DINGTALK_MAIL_SMTP_HOST=smtp.qiye.aliyun.com
DINGTALK_MAIL_SMTP_PORT=465
DINGTALK_MAIL_SMTP_SSL=true
DINGTALK_MAIL_FOLDER=INBOX
# 可留空，系统优先通过 IMAP \\Sent 标记自动识别；识别失败时填写服务端实际目录名
DINGTALK_MAIL_SENT_FOLDER=
DINGTALK_MAIL_TIMEOUT=30
DINGTALK_MAIL_SYNC_LIMIT=50
DINGTALK_MAIL_SYNC_INTERVAL_MINUTES=5

# 预警检查在日报同步（默认09:45）之后运行
ENABLE_WARNING_NOTIFICATION=true
WARNING_CHECK_HOUR=9
WARNING_CHECK_MINUTE=55
INTELLIGENCE_SNAPSHOT_HOUR=10
INTELLIGENCE_SNAPSHOT_MINUTE=0
